{
  "name": "@ohah/pdf",
  "version": "0.1.0",
  "description": "브라우저에서 PDF 를 읽고 그리고 고친다. Zig 로 짠 wasm 엔진을 워커에서 돌린다.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "cmaps",
    "src",
    "c",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./pdf.wasm": "./dist/pdf.wasm",
    "./package.json": "./package.json",
    "./cmaps/*": "./cmaps/*"
  },
  "scripts": {
    "build:wasm": "bash scripts/build.sh",
    "build:js": "bash scripts/build-js.sh",
    "build": "npm run build:wasm && npm run build:js",
    "test": "bash tests/run.sh",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@zntc/core": "^0.1.6",
    "@zntc/vite-plugin": "^0.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "keywords": [
    "pdf",
    "wasm",
    "zig",
    "viewer",
    "react",
    "vue",
    "svelte",
    "worker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohah/pdf.git"
  },
  "engines": {
    "node": ">=18"
  }
}
